generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  fa
  en
  tr
  ar
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum AdminRole {
  OWNER
  ADMIN
}

model Project {
  id            String               @id @default(cuid())
  slug          String               @unique
  coverImage    String?
  demoUrl       String?
  repositoryUrl String?
  technologies  String[]             @default([])
  featured      Boolean              @default(false)
  published     Boolean              @default(false)
  publishedAt   DateTime?
  sortOrder     Int                  @default(0)
  translations  ProjectTranslation[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([published, sortOrder])
}

model ProjectTranslation {
  id              String   @id @default(cuid())
  language        Language
  title           String
  summary         String?  @db.Text
  description     String   @db.Text
  content         String?  @db.Text
  role            String?
  metaTitle       String?
  metaDescription String?  @db.Text
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, language])
  @@index([language])
}

model Profile {
  id           String               @id @default(cuid())
  email        String?
  phone        String?
  location     String?
  avatar       String?
  resumeUrl    String?
  translations ProfileTranslation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ProfileTranslation {
  id        String   @id @default(cuid())
  language  Language
  fullName  String
  role      String
  bio       String   @db.Text
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, language])
}

model NavigationMenu {
  id        String           @id @default(cuid())
  key       String           @unique
  title     String
  location  String           @default("header")
  enabled   Boolean          @default(true)
  items     NavigationItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([location, enabled])
}

model NavigationItem {
  id           String                      @id @default(cuid())
  menuId       String
  menu         NavigationMenu              @relation(fields: [menuId], references: [id], onDelete: Cascade)
  key          String
  href         String
  external     Boolean                     @default(false)
  enabled      Boolean                     @default(true)
  sortOrder    Int                         @default(0)
  translations NavigationItemTranslation[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([menuId, key])
  @@index([menuId, enabled, sortOrder])
}

model NavigationItemTranslation {
  id       String         @id @default(cuid())
  itemId   String
  item     NavigationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  language Language
  label    String

  @@unique([itemId, language])
}

model PageSection {
  id           String                   @id @default(cuid())
  key          String                   @unique
  type         String
  enabled      Boolean                  @default(true)
  sortOrder    Int                      @default(0)
  settings     Json?
  translations PageSectionTranslation[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([enabled, sortOrder])
}

model PageSectionTranslation {
  id          String      @id @default(cuid())
  sectionId   String
  section     PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  language    Language
  title       String?
  subtitle    String?
  description String?     @db.Text
  content     Json?

  @@unique([sectionId, language])
}

model Media {
  id           String        @id @default(cuid())
  type         MediaType     @default(IMAGE)
  url          String
  storageKey   String?
  originalName String?
  alt          String?
  mimeType     String?
  sizeBytes    BigInt?
  width        Int?
  height       Int?
  createdAt    DateTime      @default(now())
  blogCovers   BlogArticle[] @relation("BlogCoverMedia")

  @@index([type, createdAt])
}

model SiteSettings {
  id           String                    @id @default(cuid())
  key          String                    @unique
  value        Json?
  translations SiteSettingsTranslation[]
  updatedAt    DateTime                  @updatedAt
}

model SiteSettingsTranslation {
  id         String       @id @default(cuid())
  settingsId String
  settings   SiteSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  language   Language
  value      Json?

  @@unique([settingsId, language])
}

model Skill {
  id           String             @id @default(cuid())
  name         String
  category     String?
  icon         String?
  level        Int?
  featured     Boolean            @default(false)
  enabled      Boolean            @default(true)
  sortOrder    Int                @default(0)
  translations SkillTranslation[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([enabled, sortOrder])
}

model SkillTranslation {
  id          String   @id @default(cuid())
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  language    Language
  title       String
  description String?

  @@unique([skillId, language])
}

model Experience {
  id           String                  @id @default(cuid())
  organization String
  position     String?
  startDate    DateTime?
  endDate      DateTime?
  current      Boolean                 @default(false)
  enabled      Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  translations ExperienceTranslation[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([enabled, sortOrder])
}

model ExperienceTranslation {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  language     Language
  title        String
  description  String?    @db.Text

  @@unique([experienceId, language])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  label     String?
  url       String
  icon      String?
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  username     String?   @unique
  phone        String?
  avatarUrl    String?
  role         AdminRole @default(ADMIN)
  permissions  String[]  @default([])
  tokenVersion Int       @default(0)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Message {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  content   String        @db.Text
  status    MessageStatus @default(NEW)
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
  NATIVE
}

model LanguageSkill {
  id           String                     @id @default(cuid())
  name         String
  level        CEFRLevel
  proficiency  Int                        @default(0)
  enabled      Boolean                    @default(true)
  sortOrder    Int                        @default(0)
  translations LanguageSkillTranslation[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([enabled, sortOrder])
}

model LanguageSkillTranslation {
  id              String        @id @default(cuid())
  languageSkillId String
  languageSkill   LanguageSkill @relation(fields: [languageSkillId], references: [id], onDelete: Cascade)
  language        Language
  title           String
  description     String?

  @@unique([languageSkillId, language])
}

enum BlogArticleStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model BlogArticle {
  id            String                   @id @default(cuid())
  status        BlogArticleStatus        @default(DRAFT)
  featured      Boolean                  @default(false)
  allowComments Boolean                  @default(true)
  coverMediaId  String?
  coverMedia    Media?                   @relation("BlogCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  translations  BlogArticleTranslation[]
  categories    BlogArticleCategory[]
  tags          BlogArticleTag[]
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([status, publishedAt])
  @@index([featured, status])
  @@index([scheduledAt, status])
  @@index([createdAt])
}

model BlogArticleTranslation {
  id              String      @id @default(cuid())
  articleId       String
  article         BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  language        Language
  title           String
  slug            String
  excerpt         String?     @db.Text
  content         Json
  metaTitle       String?
  metaDescription String?     @db.Text
  canonicalUrl    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([articleId, language])
  @@unique([language, slug])
  @@index([language])
}

model BlogCategory {
  id           String                    @id @default(cuid())
  enabled      Boolean                   @default(true)
  sortOrder    Int                       @default(0)
  translations BlogCategoryTranslation[]
  articles     BlogArticleCategory[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([enabled, sortOrder])
}

model BlogCategoryTranslation {
  id          String       @id @default(cuid())
  categoryId  String
  category    BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  language    Language
  name        String
  slug        String
  description String?      @db.Text

  @@unique([categoryId, language])
  @@unique([language, slug])
}

model BlogTag {
  id           String               @id @default(cuid())
  enabled      Boolean              @default(true)
  translations BlogTagTranslation[]
  articles     BlogArticleTag[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model BlogTagTranslation {
  id       String   @id @default(cuid())
  tagId    String
  tag      BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  language Language
  name     String
  slug     String

  @@unique([tagId, language])
  @@unique([language, slug])
}

model BlogArticleCategory {
  articleId  String
  categoryId String
  article    BlogArticle  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([articleId, categoryId])
  @@index([categoryId])
}

model BlogArticleTag {
  articleId String
  tagId     String
  article   BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       BlogTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

enum PollStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PollType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ANSWERED
  ARCHIVED
}

model Poll {
  id           String            @id @default(cuid())
  status       PollStatus        @default(DRAFT)
  type         PollType          @default(SINGLE_CHOICE)
  startsAt     DateTime?
  endsAt       DateTime?
  showResults  Boolean           @default(true)
  translations PollTranslation[]
  options      PollOption[]
  ballots      PollBallot[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, startsAt, endsAt])
  @@index([createdAt])
}

model PollTranslation {
  id          String   @id @default(cuid())
  pollId      String
  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  language    Language
  title       String
  description String?  @db.Text

  @@unique([pollId, language])
  @@index([language])
}

model PollOption {
  id           String                  @id @default(cuid())
  pollId       String
  poll         Poll                    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  sortOrder    Int                     @default(0)
  translations PollOptionTranslation[]
  votes        PollVote[]
  createdAt    DateTime                @default(now())

  @@index([pollId, sortOrder])
}

model PollOptionTranslation {
  id       String     @id @default(cuid())
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  language Language
  label    String

  @@unique([optionId, language])
}

model PollBallot {
  id        String     @id @default(cuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voterKey  String
  votes     PollVote[]
  createdAt DateTime   @default(now())

  @@unique([pollId, voterKey])
  @@index([createdAt])
}

model PollVote {
  id        String     @id @default(cuid())
  ballotId  String
  ballot    PollBallot @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([ballotId, optionId])
  @@index([optionId])
  @@index([createdAt])
}

model Feedback {
  id         String         @id @default(cuid())
  name       String?
  email      String?
  subject    String?
  content    String         @db.Text
  rating     Int?
  status     FeedbackStatus @default(NEW)
  adminReply String?        @db.Text
  repliedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}
